# Ignore everything
*

# But not these files...
!*.c
!*.h

# Also, do not ignore directories
!*/

# Ignore hidden directories specifically
.**/
# But allow .gitignore
!.gitignore

# Include data folder
!data/**

# Track post-processing tools kept under misc/
!misc/**

# run/Makefile holds the build flags of the cases.
!run/Makefile

# test/Makefile and the reference outputs of the tests.
!test/Makefile
!test/*.ref
